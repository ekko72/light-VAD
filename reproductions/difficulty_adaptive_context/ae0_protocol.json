  "outcome_definitions": {
    "short_wrong": "(short_score >= 0.5) != label",
    "refined_wrong": "(refined_score >= 0.5) != label",
    "correction_all": "short_wrong and not refined_wrong",
    "harm_all": "not short_wrong and refined_wrong",
    "selected": "abs(short_score - 0.5) <= 0.13",
    "uncertainty": "abs(short_score - 0.5)",
    "A_gross_c": "mean(correction_all)",
    "A_net_c": "mean(correction_all) - mean(harm_all)",
    "U_gate_c": "mean((correction_all and selected) - (harm_all and selected))",
    "O_c": "AUROC(correction_all, uncertainty) with higher uncertainty predicting correction",
    "P_c": "U_gate_c / A_net_c when A_net_c > 0; otherwise undefined",
    "harm_auroc_c": "AUROC(harm_all, uncertainty) with higher uncertainty predicting harm",
    "selected_correction_recall_c": "P(selected | correction_all)",
    "selected_harm_rate_c": "P(selected | harm_all)"
  },
  "auroc": {
    "direction": "higher uncertainty predicts the positive event",
    "tie_handling": "average ranks",
    "implementation_rule": "For each positive-negative pair, a strict win contributes 1.0 and a tie contributes 0.5.",
    "undefined_rule": "Return null when either the positive or negative class is empty."
  },
  "classification": {
    "precedence": [
      {
        "label": "AVAILABILITY_LIMITED",
        "rule": "A_net_c <= 0"
