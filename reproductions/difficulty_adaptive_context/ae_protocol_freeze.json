  "ae1": {
    "question": "Is OOD failure explained by scarce refinement value, refinement harm, or irreducible difficulty?",
    "operation": "Classify every test frame by the frozen Short and RF384 outcomes, then aggregate by frozen condition and cell.",
    "states": {
      "Short-sufficient": "short_correct and refined_correct",
      "Refinable": "not short_correct and refined_correct",
      "RF384-Irreducible": "not short_correct and not refined_correct",
      "Refinement-Harm": "short_correct and not refined_correct"
    },
    "point_metrics": [
      "frames",
      "state_count",
      "state_rate",
      "availability_gross",
      "availability_net",
      "gate_utility",
      "activation_rate",
      "selected_refinable_rate",
      "selected_harm_rate"
    ],
    "availability_gross": "mean(Refinable)",
    "availability_net": "mean(Refinable) - mean(Refinement-Harm)",
    "gate_utility": "mean(selected and Refinable) - mean(selected and Refinement-Harm)",
    "outputs": [
      "ae1_state_summary.csv",
      "ae1_state_by_cell.csv",
      "ae1_condition_availability.csv"
    ],
    "interpretation_rule": "A negative or near-zero availability_net is value scarcity. Positive availability_net with low gate utility is an observability/actionability question. High RF384-Irreducible rate is irreducible difficulty."
  },
  "ae2": {
    "question": "What temporal horizon is sufficient under each condition, and is correctness monotone in temporal span?",
    "operation": "Use the five frozen RF bundles and the frozen Short predictions to compute first-correct and stable-sufficient horizons for every test frame.",
    "span_order": [
      64,
      128,
      256,
      384,
      512
    ],
    "horizon_definitions": {
      "Short-sufficient": "short_correct",
      "first_correct": "minimum RF span with refined_correct at that span",
      "stable_sufficient": "minimum RF span such that that span and every larger span are correct",
      "Never-correct": "no tested RF span is correct",
      "Unstable-correct": "some span is correct but no stable sufficient span exists"
    },
    "non_monotonicity": {
      "frame_rule": "Within the ordered span sequence, a non-monotone frame has at least one correct-to-wrong transition.",
      "denominator": "not short_correct",
      "reported_rates": [
        "non_monotone_rate",
        "first_correct_histogram",
        "stable_sufficient_histogram",
        "never_correct_rate"
      ]
    },
    "point_metrics": [
      "frames",
      "short_sufficient_rate",
      "first_correct_span_histogram",
      "stable_sufficient_span_histogram",
      "never_correct_rate",
      "unstable_correct_rate",
      "non_monotone_rate",
      "oracle_net_utility_by_span"
    ],
    "oracle_net_utility_by_span": "mean(refined_correct at span) - mean(short_correct)",
    "outputs": [
      "ae2_horizon_summary.csv",
      "ae2_horizon_by_cell.csv",
      "ae2_nonmonotonicity.csv"
    ],
    "interpretation_rule": "A larger OOD stable horizon than development supports an OOD context-demand shift. No stable span effect supports temporal span not being the main bottleneck."
  },
  "ae3": {
